{
  "name": "liveclass-ide",
  "version": "0.0.0",
  "private": true,
  "description": "LiveClass IDE — real-time programming classroom platform (Bring Your Own IDE)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs && git diff --exit-code -- packages/protocol/src/liveclass_protocol/models.py packages/shared-types/src/generated",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
