# ---- PostgreSQL (durable application state) ----
POSTGRES_USER=liveclass
POSTGRES_PASSWORD=liveclass
POSTGRES_DB=liveclass
# Host port 5433 avoids clashing with a native Postgres on 5432; 127.0.0.1 forces IPv4.
DATABASE_URL=postgresql+asyncpg://liveclass:liveclass@127.0.0.1:5433/liveclass

# ---- Redis (ephemeral real-time state + pub/sub) ----
REDIS_URL=redis://127.0.0.1:6380/0

# ---- Auth / JWT ----
JWT_SECRET=dev-only-change-me-please-set-a-real-32B+-secret
JWT_ISSUER=liveclass
JWT_AUDIENCE=liveclass-clients
JWT_EXPIRES_SECONDS=3600

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
PROTOCOL_VERSION=1.0

# ---- Collaboration tunables ----
# Op buffer window (N) MUST be larger than snapshot interval (K) — invariant D6.
OP_BUFFER_WINDOW=512
SNAPSHOT_INTERVAL=128
WS_MAX_MSG_BYTES=262144
WS_MSGS_PER_SEC=50
WS_HEARTBEAT_INTERVAL_MS=15000
