{
  "name": "liveclass-ide",
  "publisher": "jay4ignite",
  "displayName": "LiveClass IDE",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "liveclass.login",
        "title": "LiveClass: Sign In"
      },
      {
        "command": "liveclass.createClass",
        "title": "LiveClass (Teacher): Create Class"
      },
      {
        "command": "liveclass.createSession",
        "title": "LiveClass (Teacher): Create Session"
      },
      {
        "command": "liveclass.selectProject",
        "title": "LiveClass (Teacher): Select Project"
      },
      {
        "command": "liveclass.startSharing",
        "title": "LiveClass (Teacher): Start Sharing"
      },
      {
        "command": "liveclass.stopSharing",
        "title": "LiveClass (Teacher): Stop Sharing"
      },
      {
        "command": "liveclass.viewStudents",
        "title": "LiveClass (Teacher): View Connected Students"
      },
      {
        "command": "liveclass.pauseSync",
        "title": "LiveClass (Teacher): Pause Synchronization"
      },
      {
        "command": "liveclass.resumeSync",
        "title": "LiveClass (Teacher): Resume Synchronization"
      },
      {
        "command": "liveclass.endSession",
        "title": "LiveClass (Teacher): End Session"
      },
      {
        "command": "liveclass.chooseWorkspace",
        "title": "LiveClass (Student): Choose Workspace"
      },
      {
        "command": "liveclass.approveWorkspace",
        "title": "LiveClass (Student): Approve Workspace"
      },
      {
        "command": "liveclass.joinSession",
        "title": "LiveClass (Student): Join Session"
      },
      {
        "command": "liveclass.followTeacher",
        "title": "LiveClass (Student): Follow Teacher"
      },
      {
        "command": "liveclass.stopFollowing",
        "title": "LiveClass (Student): Stop Following"
      },
      {
        "command": "liveclass.leaveSession",
        "title": "LiveClass (Student): Leave Session"
      }
    ],
    "configuration": {
      "title": "LiveClass",
      "properties": {
        "liveclass.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "LiveClass server base URL (REST; the WebSocket URL is derived as ws(s)://host/ws)"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liveclass",
          "title": "LiveClass",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "liveclass": [
        {
          "id": "liveclass.actions",
          "name": "LiveClass Controls"
        }
      ]
    }
  },
  "tsup": {
    "entry": [
      "src/extension.ts"
    ],
    "format": [
      "cjs"
    ],
    "external": [
      "vscode"
    ],
    "noExternal": [
      "@liveclass/sync-engine",
      "@liveclass/shared-types",
      "ws"
    ],
    "outDir": "dist"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@liveclass/shared-types": "workspace:*",
    "@liveclass/sync-engine": "workspace:*",
    "adm-zip": "^0.6.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.13"
  }
}
